{
	"name": "audiobus",
	"version": "3.2.1",
	"description": "Core audio engine with MIDI processing, synthesis, and audio routing",
	"type": "module",
	"main": "index.ts",
	"exports": {
		".": "./index.ts",
		"./commands": "./commands/commands.ts",
		"./commands/*": "./commands/*",
		"./models/*": "./models/*",
		"./events/*": "./events/*",
		"./effects": "./effects/index.ts",
		"./effects/*": "./effects/*",
		"./instruments": "./instruments/index.ts",
		"./instruments/*": "./instruments/*",
		"./synthesis": "./synthesis/index.ts",
		"./synthesis/*": "./synthesis/*",
		"./io": "./io/index.ts",
		"./io/*": "./io/*",
		"./midi": "./midi/index.ts",
		"./midi/*": "./midi/*",
		"./timing": "./timing/index.ts",
		"./timing/*": "./timing/*",
		"./tuning": "./tuning/index.ts",
		"./tuning/*": "./tuning/*",
		"./conversion": "./conversion/index.ts",
		"./conversion/*": "./conversion/*",
		"./storage": "./storage/index.ts",
		"./storage/*": "./storage/*",
		"./exporters/*": "./exporters/*",
		"./importers/*": "./importers/*",
		"./ui": "./ui/index.ts",
		"./ui/*": "./ui/*",
		"./hardware/*": "./hardware/*",
		"./visualisation/*": "./visualisation/*",
		"./*": "./*"
	},
	"scripts": {
		"test": "vitest",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"upgrader": "npx npm-check-updates --interactive -u"
	},
	"files": [
		"*.ts",
		"commands",
		"models",
		"events",
		"effects",
		"instruments",
		"synthesis",
		"io",
		"midi",
		"timing",
		"tuning",
		"conversion",
		"storage",
		"exporters",
		"importers",
		"ui",
		"hardware",
		"utils",
		"visualisation"
	],
	"dependencies": {
		"@harmoneasy/shared-config": "workspace:^",
		"@magenta/music": "^1.23.1",
		"@mediapipe/tasks-vision": "1.2.0",
		"@msgpack/msgpack": "^3.1.3",
		"@opendaw/lib-dom": "0.0.77",
		"@opendaw/lib-dsp": "0.0.77",
		"@opendaw/studio-adapters": "0.0.99",
		"@opendaw/studio-core": "0.0.126",
		"@spotify/basic-pitch": "^1.0.1",
		"@tonejs/midi": "^2.0.28",
		"butterchurn": "^2.6.7",
		"butterchurn-presets": "^2.4.7",
		"coi-serviceworker": "0.1.7",
		"control-surface": "workspace:^",
		"fflate": "^0.8.2",
		"kokoro-js": "^1.2.1",
		"lz-string": "^1.5.0",
		"netronome": "workspace:^",
		"pink-trombone": "workspace:^",
		"pitfalls": "workspace:^",
		"sion": "workspace:^",
		"standardized-audio-context": "^25.3.77",
		"supersonic-scsynth": "0.64.0",
		"supersonic-scsynth-bundle": "^0.64.0",
		"tone": "^15.1.22",
		"vexflow": "^5.0.0",
		"webmidi": "^3.1.14"
	},
	"devDependencies": {
		"typescript": "~5.9.3",
		"vitest": "^4.1.11"
	}
}
