	"portNames": ["OP-1", "OP1", "OP-1 MIDI Device", "Teenage Engineering OP-1"],
	"description": "Original OP-1 portable synthesizer with USB MIDI keyboard, sequencers and four controller encoders.",
	"icon": "icon.svg",
	"documentation": [
		{
			"title": "Teenage Engineering OP-1 manual and MIDI reference",
			"url": "https://teenage.engineering/guides/op-1/original/song-rendering-and-connectivity"
		}
	],
	"abilities": ["USB MIDI notes", "Sequencer MIDI output", "Configurable controller encoders"],
	"hardwareControls": [
		"24 keys",
		"Blue encoder",
		"Green encoder",
		"White encoder",
		"Orange encoder"
	],
	"notice": "Original OP-1, rather than OP-1 field. Connect USB and press Shift + COM, then T2 (CTRL) for controller mode. Use Shift with the encoders to set their behavior and the MIDI channel. Set encoders to absolute mode and use MIDI learn to match their assignments; CC1-4 here are virtual defaults. Normal OP-1 mode also transmits notes and sequencer output. Virtual keys start at note 48.",
