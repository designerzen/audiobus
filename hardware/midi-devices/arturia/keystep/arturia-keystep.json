{
	"$schema": "../../profile.schema.json",
	"schemaVersion": 1,
	"id": "arturia-keystep",
	"name": "Arturia KeyStep",
	"manufacturer": "Arturia",
	"manufacturerUrl": "https://www.arturia.com/",
	"ids": ["arturia-keystep"],
	"portNames": ["KeyStep", "Arturia KeyStep", "Arturia KeyStep MIDI 1"],
	"description": "Original 32-key controller, arpeggiator and step sequencer with pitch and modulation strips.",
	"icon": "icon.svg",
	"documentation": [
		{
			"title": "Arturia KeyStep manual and MIDI reference",
			"url": "https://dl.arturia.net/products/keystep/manual/KeyStep_Manual_1_1_1_EN.pdf"
		}
	],
	"abilities": [
		"Velocity-sensitive notes",
		"Channel aftertouch",
		"Pitch bend",
		"Modulation",
		"Sustain"
	],
	"hardwareControls": [
		"32 slim keys",
		"Pitch strip",
		"Modulation strip",
		"Sustain pedal input",
		"Arpeggiator and sequencer"
	],
	"notice": "Connect USB MIDI or the DIN MIDI output through an interface. Select the keyboard MIDI channel on the hardware. Modulation uses virtual CC1; match any reassignment in MIDI Control Center using MIDI learn. Transport can send configurable CC or MMC messages and is not assigned a fixed mapping here. The virtual keyboard starts at note 48; match the hardware octave with MIDI learn.",
	"controls": [
		{
			"id": "pitch-bend",
			"label": "Pitch bend",
			"message": {
				"type": "pitchBend"
			},
			"widget": "slider",
			"default": 8192
		},
		{
			"id": "modulation",
			"label": "Modulation (CC1)",
			"cc": 1,
			"widget": "slider"
		},
		{
			"id": "aftertouch",
			"label": "Channel aftertouch",
			"message": {
				"type": "channelPressure"
			},
			"widget": "slider"
		},
		{
			"id": "sustain",
			"label": "Sustain pedal",
			"cc": 64,
			"widget": "toggle"
		}
	],
