	"portNames": ["minilogue", "minilogue KBD/KNOB", "minilogue SOUND"],
	"description": "Four-voice analog synthesizer with MIDI panel control.",
	"documentation": [
		{
			"title": "minilogue owner\u2019s manual: MIDI implementation chart, page 63",
			"url": "https://cdn.korg.com/us/support/download/files/23be1d77cac2c42e6f6c586cf0f75ffb.pdf#page=63"
		}
	],
	"abilities": ["Velocity-sensitive keyboard", "Filter CC", "Envelope CC", "LFO CC"],
	"hardwareControls": [
		"37 keys",
		"Filter knobs",
		"Envelope knobs",
		"LFO controls",
		"Assignable slider"
	],
	"notice": "Original minilogue only; minilogue xd uses a different implementation. Enable MIDI Tx CC on the hardware to send panel movements and MIDI Rx CC to receive them. GUI controls perform MIDI into this chain; route the chain to a MIDI output to control the synth. Configurable surface controls use virtual defaults; match your hardware preset with MIDI learn or edit note/CC/channel mappings. Keyboard surfaces start at MIDI note 48.",
